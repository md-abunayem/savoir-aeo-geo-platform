
# ============================================================
# AEO/GEO OPTIMIZATION PLATFORM - BACKEND ENVIRONMENT
# ============================================================
# Copy this file to .env and configure Neon credentials.
# Never commit .env to GitHub.
# ============================================================


# ------------------------------------------------------------
# 1. APPLICATION CONFIGURATION
# ------------------------------------------------------------

NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:3000


# ------------------------------------------------------------
# 2. POSTGRESQL DATABASE
# ------------------------------------------------------------

POSTGRES_USER=aeo_user
POSTGRES_PASSWORD=replace_with_local_db_password
POSTGRES_DB=aeo_geo

# Use a direct admin/migration connection for Drizzle migrations and runtime-role provisioning.
# It must allow creating or altering roles and granting membership in savoir_runtime.
# Runtime uses the separate restricted DATABASE_APP_URL below.
# DATABASE_URL=postgresql://migration_user:password@your-neon-host/database?sslmode=require


# ------------------------------------------------------------
# 3. REDIS
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379


# ------------------------------------------------------------
# 4. NEON OBJECT STORAGE (PRIVATE BUCKET)
# ------------------------------------------------------------

S3_ENDPOINT=
S3_BUCKET=aeo-evidence
S3_REGION=us-east-2

# Copy these values from the same Neon branch as DATABASE_APP_URL.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Runtime listener and logging
HOST=127.0.0.1
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# Required in production after restricted role provisioning:
# DATABASE_APP_URL=postgresql://runtime_user:password@your-neon-pooler-host/database?sslmode=require

# Enable after migration and restricted runtime provisioning.
AUTH_ENABLED=false
# Set to false to disable email verification (users are verified immediately upon registration)
EMAIL_VERIFICATION_ENABLED=false
# Required when enabled: independent random secrets, at least 48 characters each.
# AUTH_JWT_SECRET=
# AUTH_CSRF_SECRET=

# Brevo transactional delivery is off until credentials/sender are configured.
MAIL_ENABLED=false
BREVO_SENDER_NAME=Savoir
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# Required with AUTH_ENABLED even when MAIL_ENABLED=false.
# Independent 32-byte key encoded as 64 hexadecimal characters:
# EMAIL_PAYLOAD_KEY=

# Multi-engine monitoring (worker makes external calls only when explicitly started and enabled).
MONITORING_ENABLED=false
# OpenRouter model. Token pricing is capped at $0.10/M input and $0.50/M output.
# Native web-search charges are separate and may apply per request.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_MAX_OUTPUT_TOKENS=512
# Gemini Developer API key from AI Studio (standard or Authorization API key).
# Both API and worker load server/.env; restart BOTH after changing keys.
# Existing deployment environment values take precedence over this file.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MONITORING_DAILY_CALL_LIMIT=100
MONITORING_CALL_SPACING_SECONDS=10
GEMINI_MAX_OUTPUT_TOKENS=2048
# Optional token-only cost estimates; grounding fees are not included. Leave unset if unknown.
# GEMINI_INPUT_USD_PER_MILLION=
# GEMINI_OUTPUT_USD_PER_MILLION=

# OpenAI ChatGPT monitoring
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_OUTPUT_TOKENS=2048
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=

# Serper search API (Google AI Overviews; AI Mode is not supported)
# SERP_PROVIDER_API_KEY=
# SERP_PROVIDER_BASE_URL=https://google.serper.dev
# SERP_COST_PER_CALL_USD=0.001

# Content studio publishing (credentials are encrypted with this independent 32-byte hex key)
PUBLISHING_ENABLED=false
# PUBLISHING_TOKEN_KEY=
# Dedicated media bucket only. Never use the private S3_BUCKET here.
# S3_PUBLIC_BUCKET=
# Stable HTTPS CDN/bucket path; not an expiring signed URL.
# S3_PUBLIC_BASE_URL=
