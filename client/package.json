{
  "name": "savoir-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node init && next dev --hostname 127.0.0.1",
    "build": "node init && next build",
    "start": "node init && next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e": "playwright test",
    "build:cloudflare": "node init && node scripts/cloudflare-build.mjs",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "upload": "npm run build:cloudflare && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "^4.160.0"
  },
  "type": "module"
}
